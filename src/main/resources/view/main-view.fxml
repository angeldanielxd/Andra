<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:id="andraRaiz"
           fx:controller="pe.andra.controller.AndraPrincipalControlador"
           styleClass="app"
           prefWidth="1280.0" prefHeight="800.0">
    <StackPane fx:id="andraAplicacion">
        <StackPane fx:id="andraContenido"/>
        <VBox fx:id="andraCapaCabecera" StackPane.alignment="TOP_CENTER" maxHeight="-Infinity" pickOnBounds="false"/>
    </StackPane>
    <Pane fx:id="andraCapaFlotante" pickOnBounds="false"/>
    <StackPane fx:id="andraCapaModal"/>
    <VBox fx:id="andraZonaAvisos" styleClass="toasts" mouseTransparent="true"
          StackPane.alignment="BOTTOM_CENTER" maxWidth="-Infinity" maxHeight="-Infinity"/>
</StackPane>
